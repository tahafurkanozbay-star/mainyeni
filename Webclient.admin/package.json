{
  "name": "webclient-admin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@terraformer/arcgis": "2.1.2",
    "axios": "1.20.0",
    "bootstrap": "5.3.8",
    "esri-loader": "3.0.0",
    "file-saver": "2.0.5",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "react": "19.3.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.0",
    "react-icons": "5.5.0",
    "react-router": "8.4.0",
    "web-vitals": "6.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint src vite.config.ts vitest.config.ts",
    "lint:strict": "oxlint --deny-warnings src/runtime src/App.tsx src/main.tsx src/Business/AuthBusiness.ts src/Pages/Auth/LoginPage.tsx src/Shared/NavMenu.tsx src/Shared/Page404.tsx src/reportWebVitals.ts vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "test": "vitest",
    "test:ci": "vitest run",
    "verify": "npm run audit:language && npm run test:tooling && npm run lint:strict && npm run typecheck && npm run typecheck:strict && npm run test:ci && npm run build",
    "audit:language": "node tooling/admin-language-boundary.mjs .",
    "test:tooling": "node --test tooling/*.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "supports es6-module"
    ],
    "development": [
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.0",
    "jsdom": "30.0.1",
    "oxlint": "1.36.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "npm@11.19.0"
}
