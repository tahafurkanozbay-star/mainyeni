{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/experience/contracts.ts",
    "src/Core/AppConfig.ts",
    "src/Store/Managers/MapManager.ts",
    "src/Components/App/CompanyLogo.tsx",
    "src/Components/App/MapAna.tsx",
    "src/Components/App/NavigationBar.tsx"
  ],
  "exclude": ["node_modules", "build", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
