<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Vite emits fingerprinted files under the assets directory: immutable across releases. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache
          cacheControlMode="UseMaxAge"
          cacheControlMaxAge="365.00:00:00"
          cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Revalidate the entry document so deployments pick up new asset hashes. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <system.webServer>
    <urlCompression doStaticCompression="true" />
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <remove verb="TRACE" />
          <add verb="TRACE" allowed="false" />
        </verbs>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
