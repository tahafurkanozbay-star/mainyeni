# Kent Rehberi Webclient — local Vite configuration example.
# npm start / npm run dev creates .env from this template when .env is missing.
# .env is ignored and must never be committed; an existing .env is never overwritten.
# Only VITE_* values are browser-visible. Never place secrets, API keys or auth tokens here.

VITE_ENV=development
VITE_ENV_DEBUG=false
VITE_VERSION=$npm_package_version
VITE_ESRI_API_VERSION=5.1.24

# Prefer same-origin/BFF routing. Keep this as a relative application path.
VITE_API_URL=/api

# Local Vite proxies /api to Api.User. Both tracked launch profiles are aligned
# to HTTPS 3003 / HTTP 3002. Override only for a deliberately custom localhost
# profile; non-local origins are rejected by vite.config.ts.
VITE_API_PROXY_TARGET=https://localhost:3003

# Local map/bootstrap preview is enabled by default in Vite development so a
# missing legacy AppSettings/GIS bootstrap database cannot block the map shell.
# It does NOT mock /api/kent-rehberi or the PlanASKI-backed data flow.
VITE_LOCAL_BOOTSTRAP_PREVIEW=true

VITE_TKGM_CITY_ID=28

# Bounded runtime defaults. Override only when measurements justify it.
VITE_API_TIMEOUT_MS=15000
VITE_API_CACHE_TTL_MS=30000
VITE_API_MAX_RETRIES=2

# Feature flags for staged runtime rollout.
VITE_ADAPTIVE_RUNTIME=true
VITE_PRIVACY_TELEMETRY=true
VITE_TYPED_BOOTSTRAP=true
VITE_STRICT_ENDPOINT_POLICY=true
