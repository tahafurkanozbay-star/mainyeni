# Local development only. Copy to .env and override with non-secret values.
VITE_APP_ENV=development
VITE_APP_VERSION=24.7.3.1
VITE_ESRI_API_VERSION=4.21
VITE_API_URL=/api
VITE_API_TIMEOUT_MS=15000
VITE_API_CACHE_TTL_MS=30000
VITE_API_MAX_RETRIES=2
VITE_TKGM_CITY_ID=28

# Never place API keys, bearer tokens, passwords, or client secrets in VITE_* variables.
# Every VITE_* value is browser-readable after bundling. Authentication belongs server-side.
