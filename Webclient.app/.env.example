# Kent Rehberi Webclient — local Vite configuration example.
# Copy to .env locally; .env is ignored and must never be committed.
# Only VITE_* values are browser-visible. Never place secrets, API keys or auth tokens here.

VITE_ENV=development
VITE_VERSION=$npm_package_version
VITE_ESRI_API_VERSION=4.21

# Prefer same-origin/BFF routing. Keep this as a relative application path.
VITE_API_URL=/api
VITE_TKGM_CITY_ID=28

# Bounded runtime defaults. Override only when measurements justify it.
VITE_API_TIMEOUT_MS=15000
VITE_API_CACHE_TTL_MS=30000
VITE_API_MAX_RETRIES=2

# Feature flags for staged runtime rollout.
VITE_ADAPTIVE_RUNTIME=true
VITE_PRIVACY_TELEMETRY=true
VITE_TYPED_BOOTSTRAP=true
VITE_STRICT_ENDPOINT_POLICY=true
