# Local development template. Copy to .env locally; never commit the local file.
GENERATE_SOURCEMAP=false
REACT_APP_ENV_DEBUG=false
REACT_APP_VERSION=$npm_package_version
REACT_APP_ESRI_API_VERSION=4.21
REACT_APP_API_URL=/api
REACT_APP_API_TIMEOUT_MS=15000
REACT_APP_API_CACHE_TTL_MS=30000
REACT_APP_API_MAX_RETRIES=2
REACT_APP_ENABLE_TELEMETRY=false
REACT_APP_TKGM_CITY_ID=28

# No client-side secret is supported here. Privileged credentials belong on the server.
