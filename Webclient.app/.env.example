# 3D Altyapı / Üstyapı Koordinasyon Web Uygulaması
# .env is local-only and must never contain secrets or tokens.
# npm run dev creates .env from this template only when no .env exists.

VITE_ENV=development
VITE_ENV_DEBUG=false
VITE_VERSION=$npm_package_version
VITE_ESRI_API_VERSION=5.1.24

# Optional browser API key for other authenticated ArcGIS services.
# The default 3D scene uses OpenStreetMap and does not require this key.
# This is public client configuration, not a server credential.
VITE_ESRI_BASEMAP_CREDENTIAL=

# Kent Rehberi POI data always uses the fixed official PlanASKI browser endpoint.
# The optional TomTom variable below is only for the separate visual traffic overlay.
# Production requires CORS permission from each upstream provider.

# Optional live traffic overlay for Ankara and Türkiye using TomTom Traffic Flow (Orbis).
# Public browser API key: restrict it to your production origin and the Traffic Flow API.
# Legacy VITE_TOMTOM_TRAFFIC_CREDENTIAL is also accepted for existing local deployments.
VITE_TOMTOM_TRAFFIC_API_KEY=

# Bounded browser runtime rollout flags.
VITE_ADAPTIVE_RUNTIME=true
VITE_PRIVACY_TELEMETRY=true
VITE_TYPED_BOOTSTRAP=true
VITE_STRICT_ENDPOINT_POLICY=true
