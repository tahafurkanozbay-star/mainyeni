# 3D Altyapı / Üstyapı Koordinasyon Web Uygulaması
# .env is local-only and must never contain secrets or tokens.
# npm run dev creates .env from this template only when no .env exists.

VITE_ENV=development
VITE_ENV_DEBUG=false
VITE_VERSION=$npm_package_version
VITE_ESRI_API_VERSION=5.1.24

# Optional browser API key for 3D basemaps and World Elevation.
# Restrict to approved website referrers and Basemaps/Elevation privileges.
# This is public client configuration, not a server credential.
VITE_ARCGIS_API_KEY=

# Kent Rehberi always uses the fixed official PlanASKI browser endpoint.
# No API/provider toggle is needed. Production requires CORS permission for its origin.

# Bounded browser runtime rollout flags.
VITE_ADAPTIVE_RUNTIME=true
VITE_PRIVACY_TELEMETRY=true
VITE_TYPED_BOOTSTRAP=true
VITE_STRICT_ENDPOINT_POLICY=true
