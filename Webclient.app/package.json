{
  "name": "webclient",
  "version": "24.7.3.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.3.0",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.4.0",
    "esri-loader": "^3.7.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/release-artifacts.mjs && node scripts/build-integrity.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "dependency:verify": "node scripts/dependency-contract.mjs",
    "lint": "oxlint src tooling vite.config.ts vitest.config.ts",
    "lint:strict": "oxlint --deny-warnings src tooling vite.config.ts vitest.config.ts",
    "quality:experience": "node scripts/experience-quality-audit.js --self-test && node scripts/experience-quality-audit.js",
    "quality:vite": "node scripts/vite-migration-audit.mjs --self-test && node scripts/vite-migration-audit.mjs",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:tooling": "node --test scripts/dependency-contract.test.mjs scripts/build-integrity.test.mjs scripts/release-artifacts.test.mjs",
    "test:build-budget": "node --test scripts/web-build-budget.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:platform && npm run typecheck:gis && npm run typecheck:experience && npm run typecheck:data-search",
    "typecheck:platform": "tsc --noEmit -p tsconfig.platform.json",
    "typecheck:gis": "tsc --noEmit -p tsconfig.gis.json",
    "typecheck:experience": "tsc --noEmit -p tsconfig.experience.json",
    "typecheck:data-search": "tsc --noEmit -p tsconfig.data-search.json",
    "verify": "npm run dependency:verify && npm run lint:strict && npm run quality:experience && npm run quality:vite && npm run typecheck && npm run test:ci && npm run test:tooling && npm run test:build-budget && npm run build && npm run build:verify",
    "preview": "vite preview --host 0.0.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all", "supports es6-module"],
    "development": ["last 2 chrome version", "last 2 firefox version", "last 2 safari version"]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
