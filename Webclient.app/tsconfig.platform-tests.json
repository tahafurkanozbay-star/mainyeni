{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "vite/client"
    ]
  },
  "include": [
    "src/platform/**/*.test.ts",
    "src/platform/**/*.integration.test.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ]
}
