{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/data-search/**/*.ts",
    "src/Toolbox/SearchExecutionRuntime.ts",
    "src/Toolbox/AddressSearchRuntime.ts",
    "src/Toolbox/SearchCoordinatorRuntime.ts",
    "src/Toolbox/SearchDatasetRegistry.ts",
