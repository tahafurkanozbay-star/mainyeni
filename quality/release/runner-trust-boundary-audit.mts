import { stableSortFindings, type AuditSection, type Finding, type RepositoryInventory } from './contracts.mts';
import { workflowFiles, workflowJobBlocks, workflowTopLevelBlock, workflowTriggerProfile, jobHasSecrets, jobUsesProtectedEnvironment, type WorkflowJobBlock } from './workflow-structure.mts';

export interface RunnerTrustSignal { readonly file:string; readonly job:string; readonly selfHosted:boolean; readonly dynamicRunner:boolean; readonly externalContribution:boolean; readonly secrets:boolean; readonly protectedEnvironment:boolean; readonly repositoryWrite:boolean; readonly checkout:boolean; readonly dockerSocket:boolean; readonly privilegedContainer:boolean; readonly hostNetwork:boolean; readonly hostPid:boolean; readonly hostMount:boolean; readonly hostToolMutation:boolean; readonly persistentWorkspaceMutation:boolean; }
export interface RunnerTrustSummary { readonly workflowFiles:number; readonly jobs:number; readonly selfHostedJobs:number; readonly externalSelfHostedJobs:number; readonly privilegedSelfHostedJobs:number; readonly hostAuthorityJobs:number; readonly signals:readonly RunnerTrustSignal[]; readonly findings:readonly Finding[]; }
const SELF_HOSTED=/(?:^|[\[,'"\s])self-hosted(?:$|[\],'"\s])/i, EXPRESSION=/\$\{\{/;
const WRITE_PERMISSION=/^\s*(?:contents|actions|checks|deployments|issues|packages|pages|pull-requests|security-events|statuses)\s*:\s*write\s*(?:#.*)?$/im, WRITE_ALL=/^\s*permissions\s*:\s*write-all\s*(?:#.*)?$/im;
function runnerValue(block:WorkflowJobBlock){ const line=block.lines.find(x=>/^\s*runs-on\s*:/i.test(x.text)); if(!line)return ''; const values=[line.text.replace(/^\s*runs-on\s*:\s*/i,'')]; const start=block.lines.indexOf(line); for(let i=start+1;i<block.lines.length;i++){const next=block.lines[i]!; if(next.trimmed&&next.indent<=line.indent)break; values.push(next.text);} return values.join('\n'); }
function permissionText(block:WorkflowJobBlock){ const line=block.lines.find(x=>/^\s*permissions\s*:/i.test(x.text)); if(!line)return workflowTopLevelBlock(block.file,'permissions')?.text??''; const out=[line.text], start=block.lines.indexOf(line); for(let i=start+1;i<block.lines.length;i++){const n=block.lines[i]!; if(n.trimmed&&n.indent<=line.indent)break; out.push(n.text);} return out.join('\n'); }
function signal(block:WorkflowJobBlock):RunnerTrustSignal { const text=block.text, runner=runnerValue(block), permissions=permissionText(block), selfHosted=SELF_HOSTED.test(runner); return {file:block.file.repositoryPath,job:block.name,selfHosted,dynamicRunner:EXPRESSION.test(runner),externalContribution:workflowTriggerProfile(block.file).externalContribution,secrets:jobHasSecrets(block),protectedEnvironment:jobUsesProtectedEnvironment(block),repositoryWrite:WRITE_ALL.test(permissions)||WRITE_PERMISSION.test(permissions),checkout:/^\s*-?\s*uses\s*:\s*actions\/checkout@/im.test(text),dockerSocket:/(?:\/var\/run\/docker\.sock|DOCKER_HOST\s*=|docker\s+(?:build|run|compose|system|volume|network)\b)/i.test(text),privilegedContainer:/(?:--privileged\b|options\s*:\s*[^\n]*--privileged\b)/i.test(text),hostNetwork:/(?:--network(?:=|\s+)host\b|network_mode\s*:\s*host\b)/i.test(text),hostPid:/(?:--pid(?:=|\s+)host\b|pid\s*:\s*host\b)/i.test(text),hostMount:/(?:-v|--volume|--mount)\s+(?:type=bind,)?(?:source=|src=)?\/(?:etc|root|home|var|usr|opt|run)(?:[\/:,\s]|$)/i.test(text),hostToolMutation:/(?:sudo\s+(?:apt|apt-get|dnf|yum|brew)|(?:npm|pnpm|yarn)\s+(?:install|add)\s+-g\b|pipx?\s+install\b|dotnet\s+tool\s+install\s+--global\b)/i.test(text),persistentWorkspaceMutation:/(?:git\s+clean\s+-[^\n]*[xfd]|git\s+reset\s+--hard|chmod\s+-R|chown\s+-R)/i.test(text)}; }
function findingsFor(block:WorkflowJobBlock):Finding[]{ const s=signal(block), at={file:block.file.repositoryPath,line:block.startLine}, f:Finding[]=[]; const add=(id:string,severity:'critical'|'high'|'medium',title:string,message:string,remediation:string,blocking=false)=>f.push({id,domain:'security',severity,...(blocking?{blocking:true}:{}),title,message,location:at,remediation,tags:['ci','runner','trust-boundary']}); if(s.dynamicRunner)add('ci-runner-dynamic-selection','critical','Workflow dynamically selects its runner trust domain',`Job ${block.name} derives runs-on from an expression.`,'Use literal reviewed runner labels and split trust domains into separate jobs.',true); if(!s.selfHosted)return f; if(s.externalContribution)add('ci-runner-self-hosted-external-contribution','critical','External contribution executes on a persistent self-hosted runner',`Job ${block.name} accepts externally influenced execution on self-hosted infrastructure.`,'Use ephemeral GitHub-hosted or single-use isolated runners.',true); if((s.repositoryWrite||s.secrets)&&!s.protectedEnvironment)add('ci-runner-self-hosted-privilege-without-environment','high','Privileged self-hosted job lacks a protected environment',`Job ${block.name} combines persistent execution with write authority or secrets.`,'Bind privileged deployment to a protected environment and least-privilege credentials.'); if(s.hostToolMutation)add('ci-runner-self-hosted-host-tool-mutation','high','Self-hosted job mutates host-global tooling',`Job ${block.name} mutates host-global tooling.`,'Bake immutable images or install tools job-locally.'); if(s.dockerSocket)add('ci-runner-self-hosted-container-daemon-authority',s.externalContribution?'critical':'high','Self-hosted job reaches container-daemon authority',`Job ${block.name} reaches Docker host/daemon authority.`,'Use isolated rootless builders or ephemeral runners.',s.externalContribution); if(s.privilegedContainer)add('ci-runner-self-hosted-privileged-container','critical','Self-hosted job starts a privileged container',`Job ${block.name} enables privileged container execution.`,'Remove privileged mode or isolate on an ephemeral runner.',true); if(s.hostNetwork)add('ci-runner-self-hosted-host-network','high','Self-hosted container joins the host network namespace',`Job ${block.name} requests host networking.`,'Use an isolated job network.'); if(s.hostPid)add('ci-runner-self-hosted-host-pid','high','Self-hosted container joins the host PID namespace',`Job ${block.name} requests host PID sharing.`,'Remove host PID sharing.'); if(s.hostMount)add('ci-runner-self-hosted-sensitive-host-mount','critical','Self-hosted container mounts a sensitive host path',`Job ${block.name} bind-mounts a sensitive host path.`,'Mount only a disposable job workspace.',true); if(s.persistentWorkspaceMutation)add('ci-runner-self-hosted-persistent-workspace-mutation','medium','Self-hosted job performs broad persistent workspace mutation',`Job ${block.name} broadly mutates a persistent workspace.`,'Prefer disposable workspaces/runners.'); if((s.repositoryWrite||s.secrets)&&s.checkout&&!s.protectedEnvironment)add('ci-runner-self-hosted-privileged-checkout-isolation','high','Privileged self-hosted checkout lacks isolation boundary',`Job ${block.name} checks code out directly onto a privileged persistent host.`,'Use an ephemeral runner and protected environment.'); return f; }
export function auditRunnerTrustBoundaries(inventory:RepositoryInventory):AuditSection<RunnerTrustSummary>{ const started=performance.now(), files=workflowFiles(inventory), jobs=files.flatMap(workflowJobBlocks), signals=jobs.map(signal), findings=stableSortFindings(jobs.flatMap(findingsFor)); return {domain:'security',title:'CI runner trust-boundary audit',summary:{workflowFiles:files.length,jobs:jobs.length,selfHostedJobs:signals.filter(x=>x.selfHosted).length,externalSelfHostedJobs:signals.filter(x=>x.selfHosted&&x.externalContribution).length,privilegedSelfHostedJobs:signals.filter(x=>x.selfHosted&&(x.repositoryWrite||x.secrets)).length,hostAuthorityJobs:signals.filter(x=>x.selfHosted&&(x.dockerSocket||x.privilegedContainer||x.hostNetwork||x.hostPid||x.hostMount)).length,signals,findings},findings,elapsedMs:Math.max(0,performance.now()-started)}; }
