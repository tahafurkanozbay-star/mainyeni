import assert from 'node:assert/strict'; import test from 'node:test'; import { auditResponsive } from './responsive-audit.mts'; import type { FileKind,RepositoryInventory,SourceFile } from './contracts.mts';
function source(path:string,text:string,kind:FileKind='css'):SourceFile{return{absolutePath:`/repo/${path}`,repositoryPath:path,extension:'',kind,bytes:new TextEncoder().encode(text).byteLength,lines:text.split(/\r?\n/).length,text};} function inv(files:readonly SourceFile[]):RepositoryInventory{return{root:'/repo',files,ignoredDirectories:[],languageStats:[],totalFiles:files.length,totalLines:files.reduce((n,f)=>n+f.lines,0),totalBytes:files.reduce((n,f)=>n+f.bytes,0),generatedAt:'2026-09-16T00:00:00Z'};} function ids(files:readonly SourceFile[]):string[]{return auditResponsive(inv(files)).findings.map(x=>x.id);}
test('flags large fixed CSS width',()=>assert.ok(ids([source('Webclient.app/src/a.css','.panel{width:900px}')]).includes('responsive-large-fixed-width'))); test('flags legacy 100vh',()=>assert.ok(ids([source('Webclient.app/src/a.css','.app{height:100vh}')]).includes('responsive-legacy-viewport-height'))); test('flags dense fixed overlays without breakpoint',()=>assert.ok(ids([source('Webclient.app/src/a.css','.a{position:fixed}.b{position:fixed}.c{position:fixed}.d{position:fixed}')]).includes('responsive-fixed-overlays-without-breakpoint'))); test('accepts fixed overlays when stylesheet has responsive rule',()=>assert.ok(!ids([source('Webclient.app/src/a.css','.a{position:fixed}.b{position:fixed}.c{position:fixed}.d{position:fixed}@media(max-width:600px){.a{position:static}}')]).includes('responsive-fixed-overlays-without-breakpoint'))); test('flags large inline width',()=>assert.ok(ids([source('Webclient.app/src/A.tsx','<div style={{ width: "900px" }} />','typescript')]).includes('responsive-inline-fixed-width'))); test('ignores test fixtures',()=>assert.equal(auditResponsive(inv([source('Webclient.app/src/__tests__/a.css','.x{width:900px}')])).findings.length,0)); test('counts media and container contracts',()=>{const s=auditResponsive(inv([source('Webclient.app/src/a.css','@media(max-width:1px){} @container card (width>1px){}')]));assert.equal(s.summary.mediaQueries,1);assert.equal(s.summary.containerQueries,1);});
