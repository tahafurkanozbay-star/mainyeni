import assert from 'node:assert/strict';
import test from 'node:test';
import { auditArtifactProducerProvenance } from './artifact-producer-provenance-audit.mts';
import { fixtureInventory, type FixtureFileInput } from './test-helpers.mts';
function audit(text:string){return auditArtifactProducerProvenance(fixtureInventory([{path:'.github/workflows/artifacts.yml',text}] as readonly FixtureFileInput[]));}
const sha='0123456789abcdef0123456789abcdef01234567';
const download=`      - uses: actions/download-artifact@${sha}\n        with:\n          name: release-bin\n          run-id: \${{ github.event.workflow_run.id }}\n          github-token: \${{ github.token }}\n      - run: ./release-bin/check.sh\n`;
test('ignores ordinary same-run artifact data',()=>{const r=audit(`name: ci\non: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          name: reports\n      - run: cat reports/results.txt\n`);assert.equal(r.summary.artifactDownloads,1);assert.equal(r.summary.crossRunDownloads,0);assert.deepEqual(r.findings,[]);});
test('blocks input-selected executable producer run',()=>{const r=audit(`name: release\non:\n  workflow_dispatch:\n    inputs:\n      run_id: { required: true }\npermissions:\n  contents: write\njobs:\n  release:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          name: release-bin\n          run-id: \${{ inputs.run_id }}\n          github-token: \${{ github.token }}\n      - run: ./release-bin/publish.sh\n`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-dynamic-run-selector'&&x.blocking));assert.ok(r.findings.some(x=>x.id==='ci-artifact-untrusted-run-selector'&&x.blocking));assert.ok(r.findings.some(x=>x.id==='ci-artifact-cross-run-without-workflow-identity'&&x.blocking));});
test('accepts workflow_run producer binding with literal artifact identity',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    workflows: [CI]\n    types: [completed]\njobs:\n  inspect:\n    runs-on: ubuntu-latest\n    steps:\n${download}`);assert.equal(r.summary.executableCrossRunDownloads,1);assert.equal(r.summary.producerBoundDownloads,1);assert.ok(!r.findings.some(x=>x.id.includes('producer-workflow')||x.id==='ci-artifact-run-id-not-bound-to-trigger'));});
test('accepts multiline static producer allowlist',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    workflows:\n      - CI\n      - Build Release\n    types: [completed]\njobs:\n  inspect:\n    runs-on: ubuntu-latest\n    steps:\n${download}`);assert.equal(r.summary.signals[0]?.producerWorkflowCount,2);assert.equal(r.summary.producerBoundDownloads,1);});
test('blocks workflow_run without producer workflows allowlist',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    types: [completed]\njobs:\n  inspect:\n    runs-on: ubuntu-latest\n    steps:\n${download}`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-missing-producer-workflow'&&x.blocking));assert.equal(r.summary.producerBoundDownloads,0);});
test('blocks expression-derived producer workflow identity',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    workflows: [\${{ inputs.producer }}]\n    types: [completed]\njobs:\n  inspect:\n    runs-on: ubuntu-latest\n    steps:\n${download}`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-dynamic-producer-workflow'&&x.blocking));});
test('blocks static producer allowlist when run-id is not event bound',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    workflows: [CI]\n    types: [completed]\njobs:\n  inspect:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          name: release-bin\n          run-id: \${{ needs.resolve.outputs.run_id }}\n          github-token: \${{ github.token }}\n      - run: ./release-bin/check.sh\n`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-run-id-not-bound-to-trigger'&&x.blocking));assert.ok(r.findings.some(x=>x.id==='ci-artifact-dynamic-run-selector'&&x.blocking));});
test('blocks expression-derived producer repository for executable artifact',()=>{const r=audit(`name: release\non: workflow_dispatch\npermissions:\n  packages: write\njobs:\n  release:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          name: package\n          repository: \${{ inputs.repository }}\n          run-id: \${{ inputs.run_id }}\n          github-token: \${{ secrets.TOKEN }}\n      - run: npm publish ./package\n`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-dynamic-repository'&&x.blocking));});
test('blocks expression-derived artifact name in privileged consumer',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    workflows: [CI]\n    types: [completed]\npermissions:\n  contents: write\njobs:\n  publish:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          name: \${{ inputs.artifact }}\n          run-id: \${{ github.event.workflow_run.id }}\n          github-token: \${{ github.token }}\n      - run: ./dist/publish.sh\n`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-dynamic-name'&&x.blocking));});
test('blocks merge-multiple before executable consumption',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    workflows: [CI]\n    types: [completed]\npermissions:\n  contents: write\njobs:\n  publish:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          pattern: release-*\n          merge-multiple: true\n          run-id: \${{ github.event.workflow_run.id }}\n          github-token: \${{ github.token }}\n      - run: ./publish.sh\n`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-merge-multiple-executable'&&x.blocking));});
test('blocks broad unnamed cross-run executable download',()=>{const r=audit(`name: promote\non:\n  workflow_run:\n    workflows: [CI]\n    types: [completed]\njobs:\n  consume:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          run-id: \${{ github.event.workflow_run.id }}\n          github-token: \${{ github.token }}\n      - run: ./tool\n`);assert.ok(r.findings.some(x=>x.id==='ci-artifact-cross-run-broad-selection'&&x.blocking));});
test('treats release action after download as executable promotion',()=>{const r=audit(`name: release\non: workflow_dispatch\npermissions:\n  contents: write\njobs:\n  release:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/download-artifact@${sha}\n        with:\n          name: dist\n          run-id: \${{ inputs.run }}\n          github-token: \${{ github.token }}\n      - uses: softprops/action-gh-release@abcdefabcdefabcdefabcdefabcdefabcdefabcd\n        with:\n          files: dist/*\n`);assert.equal(r.summary.executableCrossRunDownloads,1);assert.ok(r.findings.some(x=>x.blocking));});
test('does not inspect non-workflow yaml',()=>{const r=auditArtifactProducerProvenance(fixtureInventory([{path:'config/artifacts.yml',text:'run-id: ${{ inputs.run }}'}] as readonly FixtureFileInput[]));assert.equal(r.summary.workflowFiles,0);assert.deepEqual(r.findings,[]);});
