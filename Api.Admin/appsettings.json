{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Primary": ""
  },
  "Platform": {
    "Database": {
      "Provider": "PGSQL",
      "CommandTimeoutSeconds": 30,
      "RetryCount": 3,
      "RetryMaxDelaySeconds": 5
    },
    "Cors": {
      "AllowedOrigins": [],
      "AllowCredentials": true
    },
    "Requests": {
      "TimeoutSeconds": 30,
      "MaxRequestBodyBytes": 10485760,
      "MaxCorrelationIdLength": 96,
      "CorrelationHeaderName": "X-Correlation-ID",
      "RejectTraceHeaderWithInvalidCharacters": true
    },
    "Health": {
      "Enabled": true,
      "LivenessPath": "/health/live",
      "ReadinessPath": "/health/ready",
      "DatabaseTimeoutSeconds": 3
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 1
    },
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 240,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0,
      "ExemptOptionsRequests": true,
      "ExemptHealthChecks": true,
      "PartitionAuthenticatedUsers": true,
      "RetryAfterSeconds": 1
    },
    "ResponseCompression": {
      "Enabled": true,
      "EnableForHttps": true
    },
    "Diagnostics": {
      "Enabled": true,
      "ServerTimingHeader": true
    },
    "SecurityHeaders": {
      "Enabled": true,
      "EnableHsts": true,
      "HstsMaxAgeSeconds": 31536000,
      "HstsIncludeSubDomains": true,
      "FrameOptions": "DENY",
      "ReferrerPolicy": "no-referrer",
      "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
      "CrossOriginResourcePolicy": "same-origin",
      "CrossOriginOpenerPolicy": "same-origin",
      "CrossOriginEmbedderPolicy": "",
      "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    },
    "Governance": {
      "Enabled": true,
      "MaxRawTargetChars": 12288,
      "MaxPathChars": 2048,
      "MaxQueryStringChars": 6144,
      "MaxQueryParameters": 128,
      "MaxHeaderCount": 64,
      "MaxHeaderValues": 128,
      "MaxHeaderBytes": 32768,
      "MaxAuthorizationHeaderBytes": 8192,
      "MaxCookieHeaderBytes": 16384,
      "MaxContentTypeHeaderBytes": 512,
      "MaxForwardedForHeaderBytes": 4096,
      "RejectTraceAndConnect": true,
      "RejectBackslashInPath": true,
      "RejectPathTraversal": true,
      "RejectEncodedPathSeparators": true,
      "RejectHeaderNewlines": true,
      "RequireKnownContentTypeForBodyRequests": true,
      "AllowedBodyContentTypes": [
        "application/json",
        "application/*+json",
        "application/geo+json",
        "application/problem+json",
        "application/x-www-form-urlencoded",
        "multipart/form-data"
      ],
      "Concurrency": {
        "Enabled": true,
        "MaxConcurrentRequests": 512,
        "MaxConcurrentPerClient": 32,
        "MaxTrackedClients": 4096,
        "ClientIdleSeconds": 120,
        "CleanupInterval": 128,
        "ExemptOptionsRequests": true,
        "ExemptHealthChecks": true,
        "RetryAfterSeconds": 1
      }
    },
    "Transport": {
      "KeepAliveTimeoutSeconds": 90,
      "RequestHeadersTimeoutSeconds": 15,
      "MaxRequestLineSizeBytes": 16384,
      "MaxRequestHeadersTotalSizeBytes": 32768,
      "MaxRequestHeaderCount": 64,
      "MaxRequestBodyBytes": 10485760
    }
  },
  "Swagger": {
    "Enabled": false
  }
}
