{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Primary": "",
    "KentRehberi": ""
  },
  "KentRehberiData": {
    "Enabled": true,
    "DefaultLimit": 500,
    "MaxLimit": 2000,
    "MaxRadiusMeters": 50000,
    "CommandTimeoutSeconds": 8,
    "ConnectionTimeoutSeconds": 5,
    "MaxPoolSize": 40,
    "CacheMaxAgeSeconds": 30,
    "HealthCheckTimeoutSeconds": 3,
    "ObjectIdCursorEnabled": false
  },
  "Platform": {
    "Database": {
      "Provider": "PGSQL",
      "CommandTimeoutSeconds": 30,
      "RetryCount": 3,
      "RetryMaxDelaySeconds": 5
    },
    "Cors": {
      "AllowedOrigins": [],
      "AllowCredentials": true
    },
    "Requests": {
      "TimeoutSeconds": 30,
      "MaxRequestBodyBytes": 10485760,
      "MaxCorrelationIdLength": 96,
      "CorrelationHeaderName": "X-Correlation-ID",
      "RejectTraceHeaderWithInvalidCharacters": true
    },
    "Health": {
      "Enabled": true,
      "LivenessPath": "/health/live",
      "ReadinessPath": "/health/ready",
      "DatabaseTimeoutSeconds": 3
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 1
    },
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 240,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0,
      "ExemptOptionsRequests": true,
      "ExemptHealthChecks": true,
      "PartitionAuthenticatedUsers": true,
      "RetryAfterSeconds": 1
    },
    "ResponseCompression": {
      "Enabled": true,
      "EnableForHttps": true
    },
    "Diagnostics": {
      "Enabled": true,
      "ServerTimingHeader": true
    },
    "SecurityHeaders": {
      "Enabled": true,
      "EnableHsts": true,
      "HstsMaxAgeSeconds": 31536000,
      "HstsIncludeSubDomains": true,
      "FrameOptions": "DENY",
      "ReferrerPolicy": "no-referrer",
      "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
      "CrossOriginResourcePolicy": "same-origin",
      "CrossOriginOpenerPolicy": "same-origin",
      "CrossOriginEmbedderPolicy": "",
      "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "Swagger": {
    "Enabled": false
  }
}
